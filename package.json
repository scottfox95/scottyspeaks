{
  "name": "scotty-speaks",
  "version": "0.3.15",
  "description": "ScottySpeaks - Local-first voice dictation for macOS",
  "main": "main.js",
  "private": true,
  "scripts": {
    "compile:globe": "node scripts/build-globe-listener.js",
    "compile:fast-paste": "node scripts/build-macos-fast-paste.js",
    "compile:text-monitor": "node scripts/build-text-monitor.js",
    "compile:parakeet-coreml": "node scripts/build-parakeet-coreml.js",
    "compile:recording-target": "node scripts/build-recording-target.js",
    "compile:native": "npm run compile:recording-target && npm run compile:globe && npm run compile:fast-paste && npm run compile:text-monitor && npm run compile:parakeet-coreml && npm run compile:meeting-recorder && npm run compile:screen-recorder",
    "prestart": "npm run compile:native",
    "start": "electron .",
    "predev": "npm run compile:native",
    "dev": "concurrently -k -r \"npm:dev:renderer\" \"npm:dev:main\"",
    "predev:main": "npm run compile:native",
    "dev:main": "cross-env NODE_ENV=development node scripts/run-electron.js --dev",
    "dev:renderer": "cd src && vite",
    "prebuild": "npm run compile:native && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx",
    "build": "cd src && vite build && cd .. && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "cd src && vite build",
    "prebuild:mac": "npm run compile:native && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:mac:arm64": "npm run build:renderer && electron-builder --mac --arm64",
    "build:mac:x64": "npm run build:renderer && electron-builder --mac --x64",
    "codex:install": "node scripts/codex-install.js",
    "install:local": "node scripts/install-local.js",
    "share": "node scripts/package-share.js",
    "settings:export": "node scripts/export-settings.js",
    "settings:import": "node scripts/import-settings.js",
    "rebuild:electron-native": "electron-rebuild -f --only better-sqlite3",
    "prepack": "npm run compile:native && npm run rebuild:electron-native && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx",
    "pack": "npm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "postpack": "node scripts/sign-mac-app.js",
    "postbuild:mac": "node scripts/sign-mac-app.js",
    "postbuild:mac:arm64": "node scripts/sign-mac-app.js",
    "predist": "npm run compile:native && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx",
    "dist": "npm run build:renderer && electron-builder",
    "download:whisper-cpp": "node scripts/download-whisper-cpp.js --current",
    "download:whisper-cpp:all": "node scripts/download-whisper-cpp.js --all",
    "download:llama-server": "node scripts/download-llama-server.js --current",
    "download:llama-server:all": "node scripts/download-llama-server.js --all",
    "download:sherpa-onnx": "node scripts/download-sherpa-onnx.js --current",
    "download:sherpa-onnx:all": "node scripts/download-sherpa-onnx.js --all",
    "format:js": "eslint . --fix && cd src && eslint . --fix && prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format": "npm run format:js",
    "format:check": "eslint . && cd src && eslint . && prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint": "eslint . && cd src && eslint .",
    "typecheck": "cd src && tsc --noEmit",
    "quality-check": "npm run format:check && npm run typecheck",
    "i18n:check": "node scripts/check-i18n.js",
    "preview": "cd src && vite preview",
    "preview:workspace": "node scripts/preview-workspace.mjs",
    "diagnose": "node scripts/diagnose.js",
    "publish": "node scripts/publish-update.js",
    "compile:meeting-recorder": "node scripts/build-meeting-recorder.js",
    "compile:screen-recorder": "node scripts/build-screen-recorder.js",
    "test": "node --test tests/*.test.cjs",
    "verify:core": "npm test && npm run typecheck && npm run build:renderer",
    "test:meetings-ui": "electron tests/electron-meetings-smoke.cjs",
    "prebuild:mac:arm64": "node scripts/build-recording-target.js --arch arm64",
    "prebuild:mac:x64": "node scripts/build-recording-target.js --arch x64",
    "test:call-agent-ui": "electron tests/electron-call-agent-smoke.cjs",
    "test:replay-ui": "electron tests/electron-replay-smoke.cjs",
    "test:cleanup-ui": "electron tests/electron-cleanup-smoke.cjs",
    "test:speech-ui": "electron tests/electron-speech-smoke.cjs",
    "test:speech-native": "node tests/local-speech-native.cjs",
    "test:target-native": "resources/bin/macos-recording-target --self-test",
    "test:transcript-ui": "electron tests/electron-transcript-smoke.cjs",
    "test:locales-ui": "electron tests/electron-locale-smoke.cjs",
    "test:workspace-ui": "electron tests/electron-workspace-smoke.cjs"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "whisper",
    "whisper.cpp",
    "electron",
    "desktop-app"
  ],
  "author": {
    "name": "Scott Tenenbaum",
    "email": "scott.f.tenenbaum@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.10",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "electron": "^36.9.5",
    "electron-builder": "^26.4.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "^7.6.3",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.3.1",
    "ffmpeg-static": "^5.2.0",
    "i18next": "^25.8.4",
    "lucide-react": "^0.518.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.7.4",
    "tailwind-merge": "^3.3.1",
    "unzipper": "^0.12.3",
    "ws": "^8.19.0",
    "zustand": "^5.0.11"
  }
}
